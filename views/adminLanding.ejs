<%- include("partials/header", { title }) %>
<%- include("partials/navbar") %>

<main class="container py-4">
  <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
    <div>
      <h1 class="page-title mb-1">Admin Tools</h1>
      <p class="text-muted mb-0">Choose a tool to manage lineups and review war activity.</p>
      <p class="text-muted small mb-0">Signed in as <%= adminUser.playerName %> · <%= adminUser.clanName %></p>
    </div>
    <form method="POST" action="/admin/logout">
      <button class="btn btn-outline-light btn-sm" type="submit">Log out</button>
    </form>
  </div>

  <div class="row g-4 admin-launcher-grid">
    <div class="col-12 col-md-6 col-xl-4">
      <a href="/admin/probation" class="text-decoration-none">
        <div class="card clan-card admin-launcher-card h-100">
          <div class="card-body d-flex flex-column">
            <div class="admin-launcher-icon" aria-hidden="true">⚠️</div>
            <h3 class="h4">Probation Review</h3>
            <p class="text-muted">Review equal-TH underperformance, failed hit-downs, and coaching warnings for risky hit-ups.</p>
            <span class="mt-auto admin-launcher-link">Review flags →</span>
          </div>
        </div>
      </a>
    </div>
    <div class="col-12 col-md-6 col-xl-4">
      <a href="/admin/war-debrief" class="text-decoration-none">
        <div class="card clan-card admin-launcher-card h-100">
          <div class="card-body d-flex flex-column">
            <div class="admin-launcher-icon" aria-hidden="true">🗡️</div>
            <h3 class="h4">Regular War Debrief</h3>
            <p class="text-muted">Compare offensive performance across recent wars, then drill into every player's attacks and matchups.</p>
            <span class="mt-auto admin-launcher-link">Open war debrief →</span>
          </div>
        </div>
      </a>
    </div>
    <div class="col-12 col-md-6 col-xl-4">
      <a href="/admin/cwl-debrief" class="text-decoration-none">
        <div class="card clan-card admin-launcher-card h-100">
          <div class="card-body d-flex flex-column">
            <div class="admin-launcher-icon" aria-hidden="true">📊</div>
            <h3 class="h4">CWL Debrief</h3>
            <p class="text-muted">Review family and player performance, mirror results, and reliable hit-up attackers by season.</p>
            <span class="mt-auto admin-launcher-link">Open CWL debrief →</span>
          </div>
        </div>
      </a>
    </div>
    <div class="col-12 col-md-6 col-xl-4">
      <a href="/admin/lineup" class="text-decoration-none">
        <div class="card clan-card admin-launcher-card h-100">
          <div class="card-body d-flex flex-column">
            <div class="admin-launcher-icon" aria-hidden="true">⚔️</div>
            <h3 class="h4">CWL Lineup Helper</h3>
            <p class="text-muted">Build family-wide CWL rosters, compare player scores, and make manual assignments.</p>
            <span class="mt-auto admin-launcher-link">Open lineup helper →</span>
          </div>
        </div>
      </a>
    </div>

    <div class="col-12 col-md-6 col-xl-4">
      <a href="/admin/missed-attacks" class="text-decoration-none">
        <div class="card clan-card admin-launcher-card h-100">
          <div class="card-body d-flex flex-column">
            <div class="admin-launcher-icon" aria-hidden="true">🎯</div>
            <h3 class="h4">Missed Attacks</h3>
            <p class="text-muted">Review missed regular-war attacks and each clan's last two CWL seasons.</p>
            <span class="mt-auto admin-launcher-link">Run missed-attacks report →</span>
          </div>
        </div>
      </a>
    </div>

    <div class="col-12 col-md-6 col-xl-4">
      <a href="/admin/participation" class="text-decoration-none">
        <div class="card clan-card admin-launcher-card h-100">
          <div class="card-body d-flex flex-column">
            <div class="admin-launcher-icon" aria-hidden="true">🕰️</div>
            <h3 class="h4">War Participation</h3>
            <p class="text-muted">Find current members who have not appeared on a war roster recently.</p>
            <span class="mt-auto admin-launcher-link">Run participation report →</span>
          </div>
        </div>
      </a>
    </div>
  </div>
</main>

<%- include("partials/footer") %>
