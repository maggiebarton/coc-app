<%- include("partials/header", { title }) %>
<%- include("partials/navbar") %>

<main class="container py-4">
  <div class="d-flex justify-content-between align-items-center gap-3 mb-4 flex-wrap">
    <div>
      <h1 class="page-title mb-1">Admin</h1>
      <p class="text-muted mb-0">
        CWL lineup helper comparing 60-day regular-war performance with the most recent CWL season.
      </p>
    </div>
  </div>

  <div class="card clan-card mb-4">
    <div class="card-body">
      <form method="GET" action="/admin">
        <div class="row g-3 align-items-end">
          <% clans.forEach(clan => { %>
          <div class="col-12 col-md-4">
            <label class="form-label mb-1" for="<%= clan.key %>Format">
              <%= clan.name %>
            </label>
            <select
              id="<%= clan.key %>Format"
              name="<%= clan.key %>Format"
              class="form-select form-select-sm"
            >
              <option value="15" <%= formats[clan.key] === "15" ? "selected" : "" %>>15v15 roster of 20</option>
              <option value="30" <%= formats[clan.key] === "30" ? "selected" : "" %>>30v30 roster of 35</option>
            </select>
            <div class="text-muted small mt-1">
              <%= clan.clanInfo?.warLeague?.name || "No CWL League" %>
            </div>
          </div>
          <% }) %>

          <div class="col-12 d-flex gap-2 flex-wrap">
            <button class="btn btn-fw-primary btn-sm" type="submit">
              Update Lineups
            </button>
            <button
              class="btn btn-outline-warning btn-sm"
              type="submit"
              formaction="/admin/overrides/reset"
              formmethod="POST"
              onclick="return window.confirm('Clear every manual lineup assignment and removal?')"
            >
              Reset all to automatic scoring
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <div class="row g-4 mb-4">
    <% lineupHelper.clans.forEach(cwlClan => { %>
    <div class="col-12 col-xl-4">
      <div class="card clan-card h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
            <div>
              <h4 class="mb-0"><%= cwlClan.name %></h4>
              <span class="text-muted small js-cwl-roster-meta">
                <% if (cwlClan.isOverflow) { %>
                  Overflow roster · <%= cwlClan.tag %>
                <% } else { %>
                  <%= cwlClan.leagueName %> · <%= cwlClan.format %>v<%= cwlClan.format %>
                <% } %>
              </span>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
              <span class="cwl-pill">
                <%= cwlClan.isOverflow ? cwlClan.members.length : `${cwlClan.members.length}/${cwlClan.targetSize}` %>
              </span>
              <button
                class="btn btn-outline-light btn-sm js-copy-cwl-roster"
                type="button"
                aria-label="Copy <%= cwlClan.name %> roster for Discord"
              >
                Copy for Discord
              </button>
            </div>
          </div>

          <div
            class="table-responsive admin-lineup-table js-cwl-roster"
            data-clan-name="<%= cwlClan.name %>"
          >
            <table class="table table-dark table-hover align-middle mb-0">
              <thead>
                <tr>
                  <th>Rank</th>
                  <th>Player</th>
                  <th>TH</th>
                  <th>Combined</th>
                </tr>
              </thead>
              <tbody>
                <% cwlClan.members.forEach(player => { %>
                <tr
                  class="js-cwl-roster-player js-player-scorecard-row player-scorecard-row"
                  tabindex="0"
                  role="button"
                  aria-label="View scorecard for <%= player.name %>"
                  data-bs-toggle="modal"
                  data-bs-target="#playerScorecardModal"
                  data-name="<%= player.name %>"
                  data-tag="<%= player.tag %>"
                  data-rank="#<%= player.rank %>"
                  data-th="<%= player.townHallLevel %>"
                  data-home="<%= player.homeClan %>"
                  data-assigned="<%= player.assignedCwlClan || 'Unassigned' %>"
                  data-override="<%= player.lineupOverride || 'automatic' %>"
                  data-reg-rank="#<%= player.regularRank %>"
                  data-cwl-rank="<%= player.cwlRank ? `#${player.cwlRank}` : 'No sample' %>"
                  data-reg-clan="<%= player.regularProposedClan || 'Unassigned' %>"
                  data-cwl-clan="<%= player.cwlProposedClan || 'Unassigned' %>"
                  data-reg-wars="<%= player.warsParticipated %>"
                  data-reg-attacks="<%= player.numberOfAttacks %>"
                  data-reg-missed="<%= player.missedAttacks %>"
                  data-reg-stars="<%= player.avgStars.toFixed(2) %>"
                  data-reg-dest="<%= player.avgDestructionPercent.toFixed(2) %>%"
                  data-reg-th-distance="<%= player.avgThDistance.toFixed(2) %>"
                  data-cwl-wars="<%= player.cwlWarsParticipated %>"
                  data-cwl-attacks="<%= player.cwlAttacksUsed %>"
                  data-cwl-missed="<%= player.cwlMissedAttacks == null ? '—' : player.cwlMissedAttacks %>"
                  data-cwl-stars="<%= player.cwlAvgStars == null ? '—' : player.cwlAvgStars.toFixed(2) %>"
                  data-cwl-dest="<%= player.cwlAvgDestructionPercent == null ? '—' : `${player.cwlAvgDestructionPercent.toFixed(2)}%` %>"
                  data-cwl-th-distance="<%= player.cwlAvgThDistance == null ? '—' : player.cwlAvgThDistance.toFixed(2) %>"
                  data-main-score="<%= toDisplayPercent(player.mainScore) %>"
                  data-reg-score="<%= toDisplayPercent(player.regularMainScore) %>"
                  data-cwl-score="<%= player.cwlMainScore == null ? '—' : toDisplayPercent(player.cwlMainScore) %>"
                  data-decision="<%= player.assignmentReason %>"
                  data-summary="<%= player.summary %>"
                >
                  <td class="js-cwl-rank">#<%= player.rank %></td>
                  <td>
                    <div class="fw-bold js-cwl-player-name"><%= player.name %></div>
                    <div class="text-muted small js-cwl-home-clan"><%= player.homeClan %></div>
                  </td>
                  <td class="js-cwl-town-hall"><%= player.townHallLevel %></td>
                  <td title="<%= player.assignmentReason %>"><%= toDisplayPercent(player.mainScore) %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
    <% }) %>
  </div>

  <div class="card clan-card mb-4">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-center gap-3 mb-3 flex-wrap">
        <div>
          <h4 class="mb-0">Ranked Player Pool</h4>
          <span class="text-muted small"><%= lineupHelper.players.length %> current members</span>
        </div>
      </div>

      <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0">
          <thead>
            <tr>
              <th>Rank</th>
              <th>Player</th>
              <th>TH</th>
              <th>Home</th>
              <th>Assigned</th>
              <th>Reg Rank</th>
              <th>CWL Rank</th>
              <th>Decision</th>
              <th>Reg Attacks</th>
              <th>CWL Attacks</th>
              <th>Reg Avg Stars</th>
              <th>CWL Avg Stars</th>
              <th>Main</th>
              <th>Reg Score</th>
              <th>CWL Score</th>
            </tr>
          </thead>
          <tbody>
            <% lineupHelper.players.forEach(player => { %>
            <tr
              class="js-player-scorecard-row player-scorecard-row"
              tabindex="0"
              role="button"
              aria-label="View scorecard for <%= player.name %>"
              data-bs-toggle="modal"
              data-bs-target="#playerScorecardModal"
              data-name="<%= player.name %>"
              data-tag="<%= player.tag %>"
              data-rank="#<%= player.rank %>"
              data-th="<%= player.townHallLevel %>"
              data-home="<%= player.homeClan %>"
              data-assigned="<%= player.assignedCwlClan || 'Unassigned' %>"
              data-override="<%= player.lineupOverride || 'automatic' %>"
              data-reg-rank="#<%= player.regularRank %>"
              data-cwl-rank="<%= player.cwlRank ? `#${player.cwlRank}` : 'No sample' %>"
              data-reg-clan="<%= player.regularProposedClan || 'Unassigned' %>"
              data-cwl-clan="<%= player.cwlProposedClan || 'Unassigned' %>"
              data-reg-wars="<%= player.warsParticipated %>"
              data-reg-attacks="<%= player.numberOfAttacks %>"
              data-reg-missed="<%= player.missedAttacks %>"
              data-reg-stars="<%= player.avgStars.toFixed(2) %>"
              data-reg-dest="<%= player.avgDestructionPercent.toFixed(2) %>%"
              data-reg-th-distance="<%= player.avgThDistance.toFixed(2) %>"
              data-cwl-wars="<%= player.cwlWarsParticipated %>"
              data-cwl-attacks="<%= player.cwlAttacksUsed %>"
              data-cwl-missed="<%= player.cwlMissedAttacks == null ? '—' : player.cwlMissedAttacks %>"
              data-cwl-stars="<%= player.cwlAvgStars == null ? '—' : player.cwlAvgStars.toFixed(2) %>"
              data-cwl-dest="<%= player.cwlAvgDestructionPercent == null ? '—' : `${player.cwlAvgDestructionPercent.toFixed(2)}%` %>"
              data-cwl-th-distance="<%= player.cwlAvgThDistance == null ? '—' : player.cwlAvgThDistance.toFixed(2) %>"
              data-main-score="<%= toDisplayPercent(player.mainScore) %>"
              data-reg-score="<%= toDisplayPercent(player.regularMainScore) %>"
              data-cwl-score="<%= player.cwlMainScore == null ? '—' : toDisplayPercent(player.cwlMainScore) %>"
              data-decision="<%= player.assignmentReason %>"
              data-summary="<%= player.summary %>"
            >
              <td>#<%= player.rank %></td>
              <td>
                <div class="fw-bold"><%= player.name %></div>
                <div class="text-muted small"><%= player.tag %></div>
              </td>
              <td><%= player.townHallLevel %></td>
              <td><%= player.homeClan %></td>
              <td><%= player.assignedCwlClan || "Unassigned" %></td>
              <td>#<%= player.regularRank %></td>
              <td><%= player.cwlRank ? `#${player.cwlRank}` : "—" %></td>
              <td>
                <span class="cwl-pill"><%= player.lineupOverride ? "Manual" : player.lineupAgreement ? "Agreement" : player.cwlRank ? "Blended" : "Regular only" %></span>
              </td>
              <td><%= player.numberOfAttacks %></td>
              <td><%= player.cwlAttacksUsed %></td>
              <td><%= player.avgStars.toFixed(2) %></td>
              <td><%= player.cwlAvgStars == null ? "—" : player.cwlAvgStars.toFixed(2) %></td>
              <td><%= toDisplayPercent(player.mainScore) %></td>
              <td><%= toDisplayPercent(player.regularMainScore) %></td>
              <td><%= player.cwlMainScore == null ? "—" : toDisplayPercent(player.cwlMainScore) %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

</main>

<div class="modal fade" id="playerScorecardModal" tabindex="-1" aria-labelledby="playerScorecardTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content scorecard-modal">
      <div class="modal-header border-secondary">
        <div>
          <h4 class="modal-title" id="playerScorecardTitle"></h4>
          <div class="text-muted small" id="playerScorecardTag"></div>
        </div>
        <div class="d-flex align-items-center gap-2 ms-auto me-3">
          <span class="cwl-pill" id="playerScorecardRank"></span>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
      </div>
      <div class="modal-body">
        <div class="scorecard-grid scorecard-modal-grid mb-3" id="playerScorecardDetails"></div>
        <div class="scorecard-scores mb-3" id="playerScorecardScores"></div>
        <p class="text-muted small mb-1" id="playerScorecardDecision"></p>
        <p class="text-muted small mb-0" id="playerScorecardSummary"></p>
        <form method="POST" action="/admin/overrides" class="lineup-override-form mt-4 pt-3 border-top border-secondary">
          <input type="hidden" name="playerTag" id="playerOverrideTag">
          <% clans.forEach(clan => { %>
          <input type="hidden" name="<%= clan.key %>Format" value="<%= formats[clan.key] %>">
          <% }) %>
          <label class="form-label" for="playerOverrideDestination">Manual lineup override</label>
          <div class="d-flex gap-2 flex-wrap">
            <select class="form-select" name="destination" id="playerOverrideDestination">
              <option value="automatic">Automatic (use scoring model)</option>
              <% lineupHelper.clans.forEach(clan => { %>
              <option value="<%= clan.key %>">Assign to <%= clan.name %></option>
              <% }) %>
              <option value="removed">Removed from all lineups</option>
            </select>
            <button type="submit" class="btn btn-fw-primary">Save override</button>
          </div>
          <div class="text-muted small mt-2">
            Manual assignments take priority over automatic placements.
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="/javascripts/cwlRosterExport.js"></script>
<script src="/javascripts/adminPlayerModal.js"></script>
<%- include("partials/footer") %>
